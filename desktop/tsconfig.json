{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "jsxImportSource": "solid-js", "noEmit": true, "allowImportingTsExtensions": true,
    "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "allowSyntheticDefaultImports": true, "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
