{
  "name": "tutor-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm --prefix desktop run desktop:dev",
    "build": "node scripts/build-desktop.mjs",
    "typecheck": "npm --prefix desktop run typecheck",
    "start": "npm --prefix desktop run desktop:dev",
    "pretest": "npm run test:ui",
    "test": "cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --lib -- --test-threads=4",
    "test:ui": "npm --prefix desktop run test:blueprint",
    "test:tools": "node --test scripts/tests/*.test.mjs",
    "desktop:build": "npm --prefix desktop run desktop:build",
    "desktop:install": "npm ci --prefix desktop"
  }
}
