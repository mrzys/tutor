[Unit]
Description=Zhijiao teaching and paper assembly
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tutor-v1
Group=tutor-v1
WorkingDirectory=/opt/tutor-v1/current
EnvironmentFile=/etc/tutor-v1.env
Environment=NODE_ENV=production
Environment=PATH=/opt/tutor-v1/runtime/node-v24.14.1-linux-x64/bin:/usr/bin:/bin
ExecStart=/opt/tutor-v1/runtime/node-v24.14.1-linux-x64/bin/node --import tsx scripts/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tutor-v1

[Install]
WantedBy=multi-user.target
