  "student": {
    "stem": "（2025秋·虹口区校级期中）在下列表达式中，① $0\\notin\\mathbb N$；② $\\varnothing\\subsetneq\\{0\\}$；③ $\\pi\\in\\mathbb Q$；④ $\\{1\\}\\in\\{0,1\\}$，其中正确的为 ______。（填写所有正确的序号）",
    "options": [],
    "parts": [],
    "assets": []
  },
  "teacher": {
    "answers": [
      {
        "partId": "main",
        "text": "②",
        "provenance": "source",
        "sourceRefs": [
