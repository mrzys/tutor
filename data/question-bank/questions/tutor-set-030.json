  "student": {
    "stem": "（2024春·博湖县期末）下列集合中表示同一集合的是（　）。",
    "options": [
      {
        "label": "A",
        "text": "$M=\\{(3,2)\\},\\ N=\\{(2,3)\\}$"
      },
      {
        "label": "B",
        "text": "$M=\\{2,3\\},\\ N=\\{3,2\\}$"
      },
      {
        "label": "C",
        "text": "$M=\\{(x,y)\\mid x+y=1\\},\\ N=\\{y\\mid x+y=1\\}$"
      },
      {
        "label": "D",
        "text": "$M=\\{2,3\\},\\ N=\\{(2,3)\\}$"
      }
    ],
