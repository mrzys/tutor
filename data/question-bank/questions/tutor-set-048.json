    "stem": "（2025·杨浦区校级模拟）已知集合 $A=(-\\infty,3)$，集合 $B=[0,4]$，则 $A\\cap B=$______。",
    "options": [],
    "parts": [],
    "assets": []
  },
  "teacher": {
    "answers": [
      {
        "partId": "main",
        "text": "$[0,3)$",
        "provenance": "source",
        "sourceRefs": [
