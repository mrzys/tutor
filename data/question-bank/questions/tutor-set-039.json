  "student": {
    "stem": "（2025春·徐汇区校级期中）若从两男两女四人中随机选出两人，设两个男生分别用 $A,B$ 表示，两个女生分别用 $C,D$ 表示，相应的样本空间为 $\\Omega=\\{AB,AC,AD,BC,BD,CD\\}$，则与事件“选出一男一女”对应的样本空间的子集为 ______。",
    "options": [],
    "parts": [],
    "assets": []
  },
  "teacher": {
    "answers": [
      {
        "partId": "main",
        "text": "$\\{AC,AD,BC,BD\\}$",
