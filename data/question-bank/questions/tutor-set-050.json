    "solutions": [
      {
        "partId": "p1",
        "text": "$\\complement_{\\mathbb{R}}M=(-\\infty,-4]\\cup[4,+\\infty)$。当 $m=-2$ 时，$N=(-5,-3)$，所以 $(\\complement_{\\mathbb{R}}M)\\cap N=(-5,-4]$。",
        "provenance": "source_adapted",
        "sourceRefs": [
          {
            "sourceId": "set-teacher",
            "pages": [
              26,
              27
            ]
          }
        ]
      },
      {
        "partId": "p2",
        "text": "$N=(2m-1,2m+1)$ 的长度恒为2，非空。条件 $(\\complement_{\\mathbb{R}}M)\\cap N=\\varnothing$ 等价于 $N\\subseteq M$。两个区间均为开区间，所以需且只需 $2m-1\\ge-4$ 且 $2m+1\\le4$；端点相等时仍符合包含关系。解得 $-3/2\\le m\\le3/2$，故 $m\\in[-3/2,3/2]$。",
        "provenance": "source_adapted",
        "sourceRefs": [
          {
            "sourceId": "set-teacher",
            "pages": [
              26,
              27
            ]
          }
        ]
      }
    ],
