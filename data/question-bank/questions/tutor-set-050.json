    "stem": "（2025·柳州开学）已知全集为 $\\mathbb{R}$，集合 $M=\\{x\\mid -4<x<4\\}$，$N=\\{x\\mid 2m-1<x<2m+1\\}$。",
    "options": [],
    "parts": [
      {
        "partId": "p1",
        "prompt": "当 $m=-2$ 时，求 $(\\complement_{\\mathbb{R}}M)\\cap N$。"
      },
      {
        "partId": "p2",
        "prompt": "若 $(\\complement_{\\mathbb{R}}M)\\cap N=\\varnothing$，求实数 $m$ 的取值范围。"
      }
