    "solutions": [
      {
        "partId": "main",
        "text": "$-3$ 不是正整数，A 错误；$\\sqrt5$ 是无理数，也是实数，B 正确；$\\frac12$ 不是整数，C 错误；$0$ 是自然数，D 错误。故选 B。",
