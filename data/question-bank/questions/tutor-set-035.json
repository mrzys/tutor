    "stem": "（2025 秋·襄城区校级月考）已知集合 $M=\\{-1,0,1\\}$，$N=\\{0,1\\}$，则（　）",
    "options": [
      {
        "label": "A",
        "text": "$M\\subseteq N$"
      },
      {
        "label": "B",
        "text": "$M\\cap N=\\varnothing$"
      },
      {
        "label": "C",
        "text": "$N\\subsetneqq M$"
      },
      {
        "label": "D",
        "text": "$M=N$"
      }
    ],
    "parts": [],
    "assets": []
  },
