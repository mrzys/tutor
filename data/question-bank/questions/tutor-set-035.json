    ],
    "solutions": [
      {
        "partId": "main",
        "text": "$N$ 的元素 0、1 均属于 $M$，且 $-1\\in M$、$-1\\notin N$，故 $N\\subsetneqq M$，C 正确。于是 A、D 错误；$M\\cap N=\\{0,1\\}\\ne\\varnothing$，B 错误。故选 C。",
        "provenance": "source_adapted",
