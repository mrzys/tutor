  "student": {
    "stem": "（2025·石景山区校级开学）已知集合 $A=\\{x\\mid x=2k,\\ k\\in\\mathbb Z\\}$，$B=\\{x\\mid x=4m+6n,\\ m,n\\in\\mathbb Z\\}$，则（　）。",
    "options": [
      {
        "label": "A",
        "text": "$A\\cap B=\\varnothing$"
      },
      {
        "label": "B",
        "text": "$A\\subsetneq B$"
      },
      {
        "label": "C",
        "text": "$A=B$"
      },
      {
        "label": "D",
        "text": "$A\\cup B=\\mathbb Z$"
      }
    ],
    "parts": [],
    "assets": []
  },
  "teacher": {
    "answers": [
