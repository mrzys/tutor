  "student": {
    "stem": "（2025秋·牡丹区校级期中）已知集合 $A=\\{x\\mid x(x-1)(x+1)=0\\}$，则 $A=$ ______。",
    "options": [],
    "parts": [],
    "assets": []
  },
  "teacher": {
    "answers": [
      {
        "partId": "main",
        "text": "$\\{-1,0,1\\}$",
        "provenance": "source",
        "sourceRefs": [
          {
            "sourceId": "set-teacher",
            "pages": [
              14
            ]
          }
        ]
      }
    ],
    "solutions": [
      {
        "partId": "main",
        "text": "三个因子的乘积为0，当且仅当至少一个因子为0。由 x=0、x−1=0 或 x+1=0 得 x=0、1 或−1，所以 $A=\\{-1,0,1\\}$。只需零乘积性质和一次方程。",
