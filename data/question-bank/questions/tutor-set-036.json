  "student": {
    "stem": "（2025秋·敖汉旗校级月考）若 $\\varnothing$ 是集合 $M=\\{x\\mid x^2-ax+1=0,\\ a\\in\\mathbb R\\}$ 的真子集，则 $a$ 的取值范围是（　）。",
    "options": [
      {
        "label": "A",
        "text": "$-2<a<2$"
      },
      {
        "label": "B",
        "text": "$a<-2\\text{ 或 }a>2$"
      },
      {
        "label": "C",
        "text": "$-2\\le a\\le2$"
      },
      {
        "label": "D",
        "text": "$a\\le-2\\text{ 或 }a\\ge2$"
      }
    ],
    "parts": [],
    "assets": []
  },
  "teacher": {
    "answers": [
      {
        "partId": "main",
        "text": "D",
        "provenance": "source",
